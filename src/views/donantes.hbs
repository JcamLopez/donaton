<div class="container.fluid">

    {{>nav-index}}
    <br><br><br><br><br>

    <div class="container-fluid">
        {{>donar}}
        <div class="row donantes ">
            <h2 class="text-dark text-center">Nuestros donantes</h2>
            <br><br><br>
            <div class="row justify-content-center bg-light">
                <div class="col-11">
                    <br>
                    <table class="table responsive text-center ">
                        <thead class="table-dark">
                            <td>
                                Nombre
                            </td>
                            <td>
                                Nacionalidad
                            </td>
                            <td>
                                Cuenta
                            </td>
                            <td>
                                Descripción
                            </td>
                            <td>
                                Fecha
                            </td>
                        </thead>

                        {{#each response}}
                         <tbody>
                            <td>
                              {{this.nombre}}
                            </td>
                            <td>
                                {{this.nacionalidad}}
                            </td>
                            <td>
                                {{this.tipo}}
                            </td>
                            <td>
                              {{this.descripcion}}
                            </td>
                             <td>
                              {{this.fecha}}
                            </td>
                        </tbody>
                       
                        {{/each}}

                    </table>
                </div>
            </div>

            <div class="row">
                <br>
            </div>
        </div>
    </div>

    {{>footer}}

</div>