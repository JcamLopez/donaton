
<div class="container-form sign-up">
    <div class="welcome-back">
        <div class="message">
            <h2>Bienvenido a DonaTree</h2>
            <p>Si ya tienes una cuenta por favor inicia sesion aqui</p>
            <button class="sign-up-btn">Iniciar Sesion</button>
        </div>
    </div>
    <div class="formulario">
        <h2 class="create-account">Crear una cuenta</h2>

        <p class="cuenta-gratis">Crear una cuenta gratis</p>
        <div class="mb-3">
            <label for="usuario" class="form-label">Nombre completo</label>
            <input type="text" id="usuario" placeholder="Por favor ingrese su nombre completo">
        </div>

        <div class="mb-3">
            <label for="nacionalidad" class="form-label">Nacionalidad</label>
            <select id="nacionalidad" class="nacionalidad">
                <option value="0">Seleccione su nacionalidad</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="registro-usuario" class="form-label">Usuario</label>
            <input type="email" id="registro-usuario" placeholder="Por favor ingrese su correo">
        </div>

        <div class="mb-3">
            <label for="clave" class="form-label">Contraseña</label>
            <input type="password" id="registro-clave" placeholder="Por fravor ingrese la contraseña">
        </div>

       <button>Registrarse</button>
    </div>
</div>