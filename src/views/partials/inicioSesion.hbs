<div class="container-form sign-in">
    <div class="formulario">
        <h2 class="create-account">Iniciar Sesión</h2>
     
        <div class="mb-3">
            
            <input type="email" id="inicio-usuario" placeholder="Por favor ingrese su correo">
        </div>

        <div class="mb-3">
            
            <input type="password" id="inicio-clave" placeholder="Por fravor ingrese la contraseña">
        </div>
        <button class="mb-3">Inciar Sesión</button>
    </div>
    <div class="welcome-back">
        <div class="message">
            <h2>Registrate</h2>
            <p>Si aun no tienes una cuenta</p>
            <button class="sign-in-btn">Registrarse</button>
        </div>
    </div>
</div>