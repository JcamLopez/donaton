<div class="container.fluid ">
    {{>nav-index}}
    <br><br>
    <br><br>
    <br>

    <div class="container ">

        {{>donar}}
        <div class="row proyectos ">
            <h2 class="text-dark text-center">Proyectos vinculados</h2>
            <br><br><br>
            {{#if proyecto}}
            {{#each proyecto}}
            <div class="row justify-content-center ">
                <div class="col-6  text-center ">
                    <img src={{this.img}} alt="">
                </div>
                <div class="col-6 align-self-center">
                    <h3>{{this.proyecto}}</h3>
                    <br>
                    <p>
                        {{this.descripcion}}
                    </p>
                </div>
            </div>
            {{/each}}
            {{else}}
            <h1>No hay proyectos</h1>
            {{/if}}




        </div>

    </div>



</div>
<br>
</div>

{{>footer}}

</div>